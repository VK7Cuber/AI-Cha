    "fastify": "^4.28.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
