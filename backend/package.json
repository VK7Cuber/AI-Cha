{
  "name": "ai-cha-backend",
  "version": "0.1.0",
  "description": "AI-Cha Terminal backend (Fastify + PostgreSQL + Redis) — базовая инфраструктура",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
