NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aicha
DB_SSL=false

# Redis (для кэша и уведомлений)
REDIS_URL=redis://localhost:6379/0

# WebSocket
# WS_AUDIO_PORT можно не указывать — будет использован WS_PORT или 8081
WS_PORT=8081
WS_PUBLIC_PORT=8082

# AI configuration
AI_PROVIDER=gigachat
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=800
AI_TOP_P=0.9
AI_REQUEST_TIMEOUT_MS=15000
AI_CONNECT_TIMEOUT_MS=5000
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_MS=500

# Yandex SpeechKit
YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_STT_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize
YANDEX_TTS_URL=https://tts.api.cloud.yandex.net/speech/v1/tts:synthesize
YANDEX_GRPC_ROOT_CA=
NODE_EXTRA_CA_CERTS=
STT_REQUEST_TIMEOUT_MS=15000
STT_MAX_RETRIES=3
STT_RETRY_BACKOFF_MS=500
STT_INPUT_FORMAT=pcm16
STT_INPUT_SAMPLE_RATE=16000
STT_INPUT_CHANNELS=1
STT_MODEL=general
STT_TEXT_NORMALIZATION=enabled
STT_PROFANITY_FILTER=false

# GigaChat
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_CA_CERT=

# Optional LLaMA provider
LLAMA_API_URL=
LLAMA_API_KEY=

# TTS settings
TTS_LANG=ru-RU
TTS_VOICE=alena
TTS_SPEED=1.0
TTS_EMOTION=neutral
TTS_FORMAT=oggopus
TTS_REQUEST_TIMEOUT_MS=15000
TTS_MAX_RETRIES=2
TTS_RETRY_BACKOFF_MS=500
TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_ENTRIES=100
TTS_CACHE_MAX_AGE_DAYS=1
TTS_PRELOAD_ENABLED=false
TTS_PRELOAD_PHRASES=Здравствуйте! Как ваше настроение сегодня?|Здравствуйте! Давайте придумаем что-нибудь вкусное специально для вас!|Не расслышал, повторите пожалуйста|Понял, спасибо!|Отлично! Я подобрал для вас несколько напитков
TTS_CHUNK_BYTES=32768
TTS_CHUNK_DELAY_MS=0

# Dialog analysis & recipes
ANALYSIS_FALLBACK_ENABLED=true
RECIPE_PRICE_MULTIPLIER=2.7
